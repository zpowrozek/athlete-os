# Copy to .env and fill in. Never commit .env.

# Strava API (https://www.strava.com/settings/api), refresh token with activity:read_all scope
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Gmail SMTP for the email-me skill (use an app password, not your account password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
